# Optional local overrides.
BASE_URL=https://www.demoblaze.com
API_BASE_URL=https://api.demoblaze.com

HEADLESS=true
ACTION_TIMEOUT_MS=15000
TEST_TIMEOUT_MS=60000
PERF_MAX_LOAD_MS=8000
PERF_MAX_TTFB_MS=3000

# Leave unset to use Playwright/CI defaults.
# WORKERS=4
# RETRIES=1

# Set both values to reuse an existing login account.
# DEMOBLAZE_USERNAME=
# DEMOBLAZE_PASSWORD=

# Required only for `npm run test:browserstack` (cloud cross-browser/OS
# matrix — see README "BrowserStack"). Get these from
# https://www.browserstack.com/accounts/settings. Never commit real values —
# in CI/Jenkins these are injected as credentials, not read from this file.
# BROWSERSTACK_USERNAME=
# BROWSERSTACK_ACCESS_KEY=
# BROWSERSTACK_MAX_WORKERS=2
