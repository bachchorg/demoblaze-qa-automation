# Copy to .env to override any of these locally. Every value here has a
# working default (see src/config/env.ts) — you only need this file to
# change behaviour, not to get the suite running.

# Target app / API.
BASE_URL=https://www.demoblaze.com
API_BASE_URL=https://api.demoblaze.com

# Browser behaviour.
HEADLESS=true
ACTION_TIMEOUT_MS=15000
TEST_TIMEOUT_MS=60000

# Parallelism / retries — left unset here to use Playwright's own CPU-based
# default locally and the CI-tuned default (2 retries) when CI=true.
# WORKERS=4
# RETRIES=1

# Optional: use one fixed, already-registered demoblaze account instead of
# having global setup provision a fresh one every run. Useful in CI if you
# want a stable, human-recognisable account in the demoblaze admin data.
# DEMOBLAZE_USERNAME=
# DEMOBLAZE_PASSWORD=
